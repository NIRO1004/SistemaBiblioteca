@model SistemaBiblioteca.Models.Categoria

@{
    ViewData["Title"] = "Detalles de la categoría";
}

<h1>Detalles de la categoría</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>

</dl>

<h4>Libros de esta categoría</h4>
<hr />

@if (Model.Libros.Any())
{
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Título</th>
                <th>Autor</th>
                <th>Año</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var libro in Model.Libros)
            {
                <tr>
                    <td>@libro.Titulo</td>
                    <td>@libro.Autor?.Nombre</td>
                    <td>@libro.AnioPublicacion</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Esta categoría no tiene libros registrados todavía.</p>
}

<div>

    <a asp-action="Edit"
       asp-route-idcategoria="@Model.IdCategoria"
       class="btn btn-warning">
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver a la lista
    </a>

</div>
