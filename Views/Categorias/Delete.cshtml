@model SistemaBiblioteca.Models.Categoria

@{
    ViewData["Title"] = "Eliminar categoría";
}

<h1>Eliminar categoría</h1>

<div class="alert alert-danger">
    <strong>¿Está seguro de que desea eliminar esta categoría?</strong>
</div>

@if (ViewData["TieneLibros"] is true)
{
    <div class="alert alert-warning">
        Esta categoría tiene libros asociados. No se puede eliminar hasta que se reasignen o eliminen esos libros.
    </div>
}

<hr />

<dl class="row">

    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>

    <dt class="col-sm-3">Cantidad de libros</dt>
    <dd class="col-sm-9">@Model.Libros.Count</dd>

</dl>

<form asp-action="Delete">

    <input type="hidden" asp-for="IdCategoria" />

    <input type="submit"
           value="Eliminar"
           class="btn btn-danger"
           disabled="@(ViewData["TieneLibros"] is true)" />

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>
