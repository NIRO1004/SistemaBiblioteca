@model IEnumerable<SistemaBiblioteca.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<h1>Gestión de Categorías</h1>

<p>
    <a asp-action="Create" class="btn btn-success">
        Registrar nueva categoría
    </a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="busqueda" value="@ViewData["Busqueda"]" class="form-control" placeholder="Buscar por nombre..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Cantidad de libros</th>
            <th width="280">Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Nombre</td>

                <td>@item.Descripcion</td>

                <td>@item.Libros.Count</td>

                <td>

                    <a asp-action="Edit"
                       asp-route-idcategoria="@item.IdCategoria"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Details"
                       asp-route-idcategoria="@item.IdCategoria"
                       class="btn btn-info btn-sm">
                        Detalles
                    </a>

                    <a asp-action="Libros"
                       asp-route-idcategoria="@item.IdCategoria"
                       class="btn btn-primary btn-sm">
                        Libros
                    </a>

                    <a asp-action="Delete"
                       asp-route-idcategoria="@item.IdCategoria"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>
