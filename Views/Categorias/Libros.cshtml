@using SistemaBiblioteca.Models
@model IEnumerable<Libro>

@{
    var categoria = ViewData["Categoria"] as Categoria;
    ViewData["Title"] = "Libros por categoría";
}

<h1>Libros en @categoria?.Nombre</h1>

<p>
    <a asp-action="Details" asp-route-idcategoria="@categoria?.IdCategoria" class="btn btn-outline-secondary btn-sm">
        Ver ficha de la categoría
    </a>
</p>

<hr />

@if (Model.Any())
{
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>ISBN</th>
                <th>Año</th>
                <th>Autor</th>
                <th>Disponibles</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var libro in Model)
            {
                <tr>
                    <td>@libro.Titulo</td>
                    <td>@libro.ISBN</td>
                    <td>@libro.AnioPublicacion</td>
                    <td>@libro.Autor?.Nombre</td>
                    <td>@libro.CantidadDisponible</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Esta categoría no tiene libros registrados todavía.</p>
}

<div>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista de categorías</a>
</div>
