@model SistemaBiblioteca.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5">

        <h1 class="text-center">Iniciar sesión</h1>

        <hr />

        <form asp-action="Index"
              asp-controller="Login"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <input type="hidden"
                   name="returnUrl"
                   value="@ViewData["ReturnUrl"]" />

            <div class="form-group mb-3">
                <label asp-for="Correo"
                       class="control-label">
                    Correo
                </label>

                <input asp-for="Correo"
                       class="form-control"
                       autocomplete="email"
                       placeholder="Ingrese su correo" />

                <span asp-validation-for="Correo"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Contrasena"
                       class="control-label">
                    Contraseña
                </label>

                <input asp-for="Contrasena"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Ingrese su contraseña" />

                <span asp-validation-for="Contrasena"
                      class="text-danger">
                </span>
            </div>

            <div class="d-grid">
                <button type="submit"
                        class="btn btn-primary">
                    Iniciar sesión
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}