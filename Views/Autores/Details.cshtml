@model SistemaBiblioteca.Models.Autor

@{
    ViewData["Title"] = "Detalles del autor";
}

<h1>Detalles del autor</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Nacionalidad</dt>
    <dd class="col-sm-9">@Model.Nacionalidad</dd>

    <dt class="col-sm-3">Fecha de nacimiento</dt>
    <dd class="col-sm-9">@Model.FechaNacimiento?.ToString("dd/MM/yyyy")</dd>

</dl>

<h4>Libros de este autor</h4>
<hr />

@if (Model.Libros.Any())
{
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Título</th>
                <th>Categoría</th>
                <th>Año</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var libro in Model.Libros)
            {
                <tr>
                    <td>@libro.Titulo</td>
                    <td>@libro.Categoria?.Nombre</td>
                    <td>@libro.AnioPublicacion</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Este autor no tiene libros registrados todavía.</p>
}

<div>

    <a asp-action="Edit"
       asp-route-idautor="@Model.IdAutor"
       class="btn btn-warning">
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver a la lista
    </a>

</div>
