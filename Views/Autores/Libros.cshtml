@using SistemaBiblioteca.Models
@model IEnumerable<Libro>

@{
    var autor = ViewData["Autor"] as Autor;
    ViewData["Title"] = "Libros por autor";
}

<h1>Libros de @autor?.Nombre</h1>

<p>
    <a asp-action="Details" asp-route-idautor="@autor?.IdAutor" class="btn btn-outline-secondary btn-sm">
        Ver ficha del autor
    </a>
</p>

<hr />

@if (Model.Any())
{
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>ISBN</th>
                <th>Año</th>
                <th>Categoría</th>
                <th>Disponibles</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var libro in Model)
            {
                <tr>
                    <td>@libro.Titulo</td>
                    <td>@libro.ISBN</td>
                    <td>@libro.AnioPublicacion</td>
                    <td>@libro.Categoria?.Nombre</td>
                    <td>@libro.CantidadDisponible</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Este autor no tiene libros registrados todavía.</p>
}

<div>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista de autores</a>
</div>
