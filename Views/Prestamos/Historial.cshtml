@model IEnumerable<SistemaBiblioteca.Models.Prestamo>

@{
    ViewData["Title"] = "Historial de préstamos";
}

<h1>Historial de préstamos</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Este usuario no tiene préstamos registrados.
    </div>
}
else
{
    <table class="table table-striped table-bordered table-hover">

        <thead class="table-dark">
            <tr>
                <th>Usuario</th>
                <th>Libro</th>
                <th>Fecha préstamo</th>
                <th>Fecha devolución</th>
                <th>Estado</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Usuario.Nombre</td>

                    <td>@item.Libro.Titulo</td>

                    <td>
                        @item.FechaPrestamo.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        @if (item.FechaDevolucion.HasValue)
                        {
                            @item.FechaDevolucion.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span>No devuelto</span>
                        }
                    </td>

                    <td>@item.Estado</td>
                </tr>
            }
        </tbody>

    </table>
}

<div>
    <a asp-action="Index"
       class="btn btn-secondary">
        Volver a préstamos
    </a>
</div>